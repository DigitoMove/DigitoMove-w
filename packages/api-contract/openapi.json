{
  "openapi": "3.0.3",
  "info": {
    "title": "Digito Move Billing API",
    "version": "1.0.0",
    "description": "Shared Laravel billing API for web and future Flutter iOS/Android clients. All amounts are whole UGX."
  },
  "paths": {
    "/api/v1/admin/invoices": {
      "get": {
        "summary": "List invoices",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated invoices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    },
                    "links": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "issued",
                "overdue",
                "paid",
                "void"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Create draft",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveInvoice"
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/invoices/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get invoice",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      },
      "put": {
        "summary": "Replace draft",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveInvoice"
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/invoices/{id}/issue": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Issue invoice",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/admin/invoices/{id}/void": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Void invoice",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoices:manage ability required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid lifecycle transition"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "summary": "Create scoped admin device token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "device_name"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  },
                  "device_name": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Store securely; shown once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      },
      "delete": {
        "summary": "Revoke current device token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/admin/invoices/{id}/receipt": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Download receipt for a paid invoice",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt PDF attachment",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role and invoice ability required"
          },
          "404": {
            "description": "Invoice missing or not paid"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "print",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Open the PDF inline for browser printing rather than download."
          }
        ]
      }
    },
    "/api/v1/admin/invoices/{id}/mark-paid": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Record full manual payment and issue a receipt",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "payment_method",
                  "payment_note",
                  "confirm_payment"
                ],
                "properties": {
                  "payment_method": {
                    "type": "string",
                    "enum": [
                      "cash",
                      "bank_transfer",
                      "mobile_money",
                      "other"
                    ]
                  },
                  "payment_reference": {
                    "type": "string",
                    "maxLength": 180,
                    "nullable": true
                  },
                  "payment_note": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "confirm_payment": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid invoice; repeat requests preserve the original payment and receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin permission required"
          },
          "409": {
            "description": "Invoice voided"
          },
          "422": {
            "description": "Payment details or confirmation missing"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "InvoiceItem": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 180
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "unit_price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "total": {
            "type": "integer",
            "readOnly": true
          }
        }
      },
      "SaveInvoice": {
        "type": "object",
        "required": [
          "client_name",
          "client_email",
          "title",
          "currency",
          "items"
        ],
        "properties": {
          "client_business": {
            "type": "string",
            "nullable": true
          },
          "client_phone": {
            "type": "string",
            "nullable": true
          },
          "client_address": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "client_name": {
            "type": "string",
            "maxLength": 180
          },
          "client_email": {
            "type": "string",
            "format": "email",
            "maxLength": 180
          },
          "title": {
            "type": "string",
            "maxLength": 180
          },
          "currency": {
            "type": "string",
            "enum": [
              "UGX"
            ]
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/InvoiceItem"
            }
          }
        }
      },
      "Invoice": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SaveInvoice"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "number": {
                "type": "string"
              },
              "total": {
                "type": "integer",
                "minimum": 500,
                "maximum": 1000000000
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "issued",
                  "paid",
                  "void"
                ]
              },
              "share_url": {
                "type": "string",
                "format": "uri",
                "nullable": true
              },
              "is_overdue": {
                "type": "boolean"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "paid_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "payment_status": {
                "type": "string",
                "nullable": true
              },
              "checkout_state": {
                "type": "string",
                "enum": [
                  "not_started",
                  "creating",
                  "ready",
                  "uncertain"
                ]
              },
              "receipt_url": {
                "type": "string",
                "format": "uri",
                "nullable": true,
                "description": "Authenticated PDF download URL; present after verified payment."
              }
            }
          }
        ]
      }
    }
  }
}
